{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "e2e/serve.ts",
    "playwright.host.config.ts",
    "host-e2e/*.spec.ts",
    "scripts/*.mjs",
    "src/features/viewer/harness/{main.tsx,vite.config.ts,*.mjs}"
  ],
  "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "host-e2e/**/*.ts", "scripts/**/*.mjs"],
  "ignore": ["src/api/schema.d.ts"],
  "ignoreExportsUsedInFile": true
}
