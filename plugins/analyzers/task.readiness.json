{
  "manifest": 1,
  "id": "analyzer.readiness",
  "version": "1.0.0",
  "title": "Series role and analysis readiness",
  "description": "PRIMARY / SECONDARY / EXCLUDED and readiness from geometry codes, localizers and interventions (ANALYZERS.md).",
  "kind": "analyzer",
  "input": "rows",
  "outputs": ["annotations"],
  "settings_schema": {
    "type": "object",
    "properties": {
      "target_profile": { "type": "string", "enum": ["generic", "kidneys", "pancreas", "lung", "brain", "heart"] }
    }
  },
  "runtime": { "type": "builtin", "entry": "plugins.analyzers.task:run_readiness" }
}
