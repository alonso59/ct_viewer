# Host dataset directory mounted at /data. Use read-only mounts for v2.0 medical curation.
DATASET_DIR=/absolute/path/to/data/dataset

# Optional extra backend-visible roots for Dataset Discovery.
# In Docker Compose these must be container paths, for example /data or /extra-data.
DATASET_ROOTS=

# Writable external state directory for read-only dataset mounts.
WEBUI_STATE_DIR_HOST=/absolute/path/to/webui_state

# Published host port (container always listens on 8000)
WEBUI_PORT=8000

# Optional shared API token (leave empty for local dev mode)
RADIOLOGY_UI_TOKEN=

# Optional backend log verbosity
LOG_LEVEL=info

# Legacy/admin source-data mutation gate. Keep false for v2.0 medical curation.
ALLOW_DATA_MUTATIONS=false

# Runtime cache budgets in bytes
VOLUME_CACHE_MAX_BYTES=805306368
SLICE_CACHE_MAX_BYTES=134217728
MESH_CACHE_MAX_BYTES=268435456
