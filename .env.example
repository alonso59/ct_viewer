# Radiology Workbench runtime config (OPS-03, docs/ops/DEPLOYMENT.md §Config).
# `./rw init` writes `.env` (gitignored) from this file; or copy it by hand.
# Read by docker-compose.yml and scripts/udocker-run.sh (OPS-09), so both runtimes run the same thing.
# Format: KEY=VALUE per line, no `export`, no ${...} interpolation.

# --- Folders (host side) ---
# Source data, mounted read-only at the SAME path inside the container (OPS-05). Required.
DATA_HOST=/absolute/path/to/data
# `:`-separated absolute dirs data may come from (OPS-04). Default: DATA_HOST.
# ALLOWED_DATA_ROOTS=/absolute/path/to/data
# Projects (rw, local disk preferred: OPS-06). Mounted at /workspace.
WORKSPACE_HOST=./workspace
# Task outputs (OPS-11), writable, outside DATA_HOST (OPS-12). Default: ./derived mounted at /derived
# (projects then pick /derived/<name> as their DERIVED root, PRJ-13). Set an absolute path to mount
# it at the same path instead.
# DERIVED_HOST=/absolute/path/to/derived
# ALLOWED_DERIVED_ROOTS=/derived   # default: DERIVED_HOST, else /derived
# External task manifests (PLUGINS_ROOT, TSK-01), mounted read-only at /plugins.
# PLUGINS_HOST=./plugins-external

# --- Network and image ---
# Host port (Docker publishes 127.0.0.1:PORT; udocker binds PORT directly). Must be >= 1024.
PORT=8000
# Base URL for share links (PRJ-03). Default: http://localhost:PORT
# PUBLIC_BASE_URL=http://localhost:8000
# Image tag to run (radiology-workbench:RW_VERSION); `make image` tags the backend/pyproject.toml version.
RW_VERSION=3.0.0.dev0

# --- Runtime specific ---
# Docker only: run as this UID:GID so workspace files belong to you (Linux hosts). Default root.
# RUN_AS=1000:1000
# udocker only: bind address (default 127.0.0.1; Docker always binds 0.0.0.0 inside the container).
# HOST=127.0.0.1
# udocker only: execution mode, P1 (default) or F3 (DEPLOYMENT.md §udocker).
# UDOCKER_EXECMODE=P1

# --- Tuning (defaults shown) ---
# JOB_WORKERS=2
# PROJECT_CACHE_MAX=4
# CACHE_MAX_GB=20
# VIEWER_MAX_LOADED=3
# LOG_LEVEL=info
