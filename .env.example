# Radiology Workbench runtime config (OPS-03, docs/ops/DEPLOYMENT.md §Config).
# Copy to `.env` (gitignored). Read by docker-compose.yml and scripts/udocker-run.sh (OPS-09).
# Format: KEY=VALUE per line, no `export`, no ${...} interpolation.

# Host folder with the source data. Mounted at the SAME path inside the container (OPS-05).
DATA_HOST=/absolute/path/to/data
# `:`-separated absolute dirs data may come from; must not be empty (OPS-04). Defaults to DATA_HOST.
ALLOWED_DATA_ROOTS=/absolute/path/to/data
# Host folder for projects (rw, local disk preferred: OPS-06). Mounted at /workspace.
WORKSPACE_HOST=./workspace
# Host folder for task outputs (converted NIfTI, masks, sidecars; OPS-11). Writable, mounted at the
# SAME path, outside DATA_HOST (OPS-12). Projects pick a subfolder as their DERIVED root (PRJ-13).
DERIVED_HOST=/absolute/path/to/derived
# ALLOWED_DERIVED_ROOTS=/absolute/path/to/derived   # default: DERIVED_HOST
# Host folder of external task manifests (PLUGINS_ROOT, TSK-01), mounted read-only at /plugins.
# Start the host runner next to the app: python scripts/rw-runner.py --workspace <WORKSPACE_HOST> --plugins <PLUGINS_HOST>
# PLUGINS_HOST=./plugins-external

# Port on the host (Docker publishes 127.0.0.1:PORT; udocker binds PORT directly). Must be >= 1024.
PORT=8000
# Base URL for share links (PRJ-03). Default: http://localhost:PORT
# PUBLIC_BASE_URL=http://localhost:8000

# Image tag to run (radiology-workbench:RW_VERSION); `make image` tags the backend/pyproject.toml version.
RW_VERSION=3.0.0.dev0
# Docker only: run as this UID:GID so workspace files belong to you (Linux hosts). Default root.
# RUN_AS=1000:1000
# udocker only: bind address (default 127.0.0.1; Docker always binds 0.0.0.0 inside the container).
# HOST=127.0.0.1
# udocker only: execution mode (P1 default; F3 may be faster, see DEPLOYMENT.md udocker notes).
# UDOCKER_EXECMODE=P1

# Tuning (defaults shown).
# JOB_WORKERS=2
# PROJECT_CACHE_MAX=4
# CACHE_MAX_GB=20
# VIEWER_MAX_LOADED=3
# LOG_LEVEL=info
