# Disposable CI-only image; the product Dockerfile/image remains unchanged.
FROM node:22-bookworm AS node
FROM python:3.12-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && python -m venv /opt/ci \
 && /opt/ci/bin/pip install --no-cache-dir uv==0.9.2
ENV PATH=/opt/ci/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    FULL_TESTS=1 PYTEST_WORKERS=4 VITEST_WORKERS=2 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
WORKDIR /repo
COPY backend/pyproject.toml backend/requirements-ci.lock /repo/backend/
RUN uv pip sync --python /opt/ci/bin/python backend/requirements-ci.lock
COPY frontend/package.json frontend/package-lock.json /repo/frontend/
RUN cd frontend && npm ci --no-audit --no-fund \
 && apt-get update \
 && apt-get install -y --no-install-recommends xauth \
 && npx playwright install --with-deps chromium firefox \
 && xvfb-run -a true \
 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN ln -s /opt/ci backend/.venv \
 && uv pip install --python /opt/ci/bin/python --no-deps -e backend
ARG VERIFY_UID=10001
ARG VERIFY_GID=10001
RUN test "$VERIFY_UID" != 0 \
 && mkdir /tmp/rw-ci-home \
 && chown "$VERIFY_UID:$VERIFY_GID" /tmp/rw-ci-home \
 && chown -R "$VERIFY_UID:$VERIFY_GID" /repo
ENV HOME=/tmp/rw-ci-home
USER ${VERIFY_UID}:${VERIFY_GID}
CMD ["make", "check", "RUNTIME=native", "VENV=/opt/ci", "FULL_TESTS=1"]
